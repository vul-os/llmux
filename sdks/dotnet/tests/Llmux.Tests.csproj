<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      Target net8.0 (the library's floor) but run on whatever runtime the
      machine has. Without this, a host with only the .NET 10 runtime aborts the
      run with "framework 'Microsoft.NETCore.App' version '8.0.0' not found",
      which looks like a test failure and is a missing-runtime error.
    -->
    <RollForward>LatestMajor</RollForward>
    <!--
      LlmuxDirect.cs (compiled below for DirectCancelTests) is declared
      `unsafe` at the class level for its `delegate* unmanaged<...>` chunk
      callback. That requires this flag for the whole project, the same as
      Llmux.csproj itself — see the comment there.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the SDK source directly (single-file library, both halves). -->
    <Compile Include="../Llmux.cs" />
    <Compile Include="../LlmuxDirect.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the fake fixture next to the test assembly. -->
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures" />
  </ItemGroup>

</Project>
