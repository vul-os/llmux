<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>to.llmux</groupId>
  <artifactId>llmux</artifactId>
  <version>0.1.7</version>
  <packaging>jar</packaging>

  <name>llmux</name>
  <description>The LLM multiplexer, embedded locally — one OpenAI-compatible client for every provider.</description>
  <url>https://llmux.to</url>

  <licenses>
    <license>
      <name>MIT</name>
    </license>
  </licenses>

  <properties>
    <!--
      The SIDECAR half (Llmux, LlmuxException) targets Java 11 and is the
      recommended way to use llmux from the JVM. The DIRECT half (LlmuxDirect)
      needs java.lang.foreign, which is permanent from Java 22, so it is
      compiled by a second execution of the compiler plugin at a higher
      release. Two releases in one artifact rather than a floor of 22 for
      everybody: an 11 consumer that never touches LlmuxDirect never loads it
      and never sees its class-file version.
    -->
    <maven.compiler.release>11</maven.compiler.release>
    <direct.release>22</direct.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      The core sidecar uses only the JDK (ProcessBuilder + java.net.http).
      The convenience OpenAI client is OPTIONAL: add com.openai:openai-java
      yourself and construct it with Llmux.openaiBaseUrl(). It is declared
      <optional> so it is not pulled into downstream classpaths transitively.
    -->
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>0.31.0</version>
      <optional>true</optional>
    </dependency>

    <!-- Test-only: JUnit 5. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <executions>
          <!-- Everything except the FFM binding, at release 11. -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <excludes>
                <exclude>to/llmux/LlmuxDirect.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <!-- The FFM binding, at release 22. Building this module therefore
               needs a JDK 22+ toolchain even though the output is usable from
               11. -->
          <execution>
            <id>compile-direct</id>
            <phase>compile</phase>
            <goals><goal>compile</goal></goals>
            <configuration>
              <release>${direct.release}</release>
              <includes>
                <include>to/llmux/LlmuxDirect.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!--
            LlmuxDirectCancelTest loads libllmux through java.lang.foreign,
            same as LlmuxDirect itself. Without this, JDK 24+ prints the
            "restricted method" warning on every run and a future release
            throws instead — see sdks/java/README.md's Direct-path
            Requirements section for the same flag on the java launch command.
          -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
          <!--
            Fixture-driven tests resolve the binary from LLMUX_BINARY. Point it
            at the real gateway (or a fake) to exercise the spawn/readiness/
            singleton/cleanup paths; otherwise those tests skip via assumptions.
            CI sets, e.g.:  mvn test -DargLine= with LLMUX_BINARY in the env, or
            uncomment below to inject a path.
          -->
          <environmentVariables>
            <LLMUX_BINARY>${env.LLMUX_BINARY}</LLMUX_BINARY>
          </environmentVariables>
          <!-- Exclude the dependency-free runnable smoke test from JUnit runs. -->
          <excludes>
            <exclude>**/LlmuxSmokeTest.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
