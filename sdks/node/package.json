{
  "name": "llmux",
  "version": "0.1.0",
  "description": "The LLM multiplexer, embedded locally — one OpenAI-compatible client for every provider.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "homepage": "https://llmux.to",
  "keywords": [
    "llm",
    "gateway",
    "openai",
    "anthropic",
    "gemini",
    "proxy",
    "litellm"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "bin/"
  ],
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:lint-config": "node scripts/check-lint-config.mjs",
    "pretest": "npm run build",
    "test": "node --test test/sidecar.test.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
